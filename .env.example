# ============================================================================
# Enterprise RAG Workbench - 环境变量样例
# 复制为 .env 后填入真实值; 不填则自动进入 Mock 降级模式, 项目仍可完整启动。
# 注意: .env 已被 .gitignore 忽略, 绝不会提交到 Git。
# ============================================================================

# ---------- 后端基础 ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
# 是否强制 Mock 模式 (true=即使配置了外部服务也走 Mock, 便于离线演示)
FORCE_MOCK=false

# ---------- PostgreSQL ----------
# 本地 docker-compose 已提供; 也可指向远端。未配置且非 Mock 时回退 SQLite(仅本地开发)。
DATABASE_URL=postgresql+psycopg://rag:rag123456@localhost:5432/rag_workbench

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Milvus ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_chunks

# ---------- 嵌入模型 (DashScope / 通义千问) ----------
# 留空 -> 使用确定性哈希 Mock 嵌入, 保证离线可跑; 填入后切换真实向量。
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ---------- 大模型 (Agent 生成) ----------
# 留空 -> 使用规则化 Mock 生成器; 填入后调用真实大模型。
LLM_PROVIDER=dashscope            # dashscope | openai | mock
LLM_API_KEY=
LLM_MODEL=qwen-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- OCR (PaddleOCR 重, RapidOCR 轻; 不装则走 Mock OCR) ----------
OCR_ENGINE=mock                  # paddle | rapid | mock
# PaddleOCR / RapidOCR 为本地依赖, 见 README "本地 OCR" 章节

# ---------- 检索与切分参数 ----------
CHUNK_SIZE=600
CHUNK_OVERLAP=80
BM25_TOP_K=20
VECTOR_TOP_K=10
# RRF 融合常数: 应与单路候选列表长度同量级。60 面向万级语料, 本库候选仅几十条故取 10
(过大会抹平名次差异, 见 eval/report.md 的参数扫描)。
RRF_K=10
# 两路融合权重: 弱嵌入下向量路会稀释强词面路, 故默认降权;
# 接入真实嵌入模型(DashScope text-embedding-v3 等)后建议把 RRF_WEIGHT_VECTOR 调回 1.0 并重跑 eval。
RRF_WEIGHT_VECTOR=0.4
RRF_WEIGHT_BM25=1.0
HYBRID_FETCH_K=30               # Prefetch 预检索取回条数
# 证据裁判(防编造): 问题内容词至少要在前 EVIDENCE_GATE_TOP_N 条证据里命中
# EVIDENCE_MIN_TERMS 个才作答, 否则如实告知“知识库中没有”。
# 依据: 91 道范围内问题放行 94.5%, 10 道无关问题拒答 10/10 (见 eval/report.md 第 3 节)。
EVIDENCE_MIN_TERMS=2
EVIDENCE_GATE_TOP_N=3

# ---------- 前端 ----------
VITE_API_BASE=http://localhost:8000
